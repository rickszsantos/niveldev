# --- Servidor ---
PORT=5050
# Gere uma chave forte com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=coloque_sua_chave_secreta_aqui

# --- Banco de dados (PostgreSQL) ---
# Rodando o backend direto na sua máquina (npm run dev) com o banco no Docker: localhost.
# Quando o backend também roda no Docker, o docker-compose.yml troca o host para "db" sozinho.
DB_HOST=localhost
DB_PORT=5432
DB_USER=niveldev
DB_PASSWORD=troque_esta_senha
DB_NAME=niveldev
